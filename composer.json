{
    "name": "decodelabs/iota",
    "description": "Discrete, dependable generated code repository",
    "type": "library",
    "keywords": [],
    "license": "MIT",
    "authors": [
        {
            "name": "Tom Wright",
            "email": "tom@inflatablecookie.com"
        }
    ],
    "require": {
        "php": "^8.4",

        "decodelabs/atlas": "^0.14",
        "decodelabs/coercion": "^0.3.3",
        "decodelabs/exceptional": "^0.6.1",
        "decodelabs/hatch": "^0.1.4",
        "decodelabs/kingdom": "^0.2",
        "decodelabs/monarch": "^0.2"
    },
    "require-dev": {
        "decodelabs/chorus": "^0.1",
        "decodelabs/genesis": "^0.14",
        "decodelabs/phpstan-decodelabs": "^0.7.0"
    },
    "conflict": {
        "decodelabs/genesis": "<0.14"
    },
    "autoload": {
        "psr-4": {
            "DecodeLabs\\Iota\\": "src/Iota",
            "DecodeLabs\\Genesis\\": "src/Genesis"
        },
        "classmap": [
            "src/Iota.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "0.3.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "decodelabs/genesis": true
        }
    }
}
